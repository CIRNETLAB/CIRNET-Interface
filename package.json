    "check:contracts": "node --test scripts/contracts-consumer.test.mjs scripts/contracts-bootstrap.test.mjs"
  },
  "dependencies": {
    "lossless-json": "4.3.1",
    "pinia": "^2.3.0",
    "three": "^0.171.0",
    "vue": "^3.5.13",
