    "@tinihi-labs/contracts": "file:.artifacts/tinihi-labs-contracts-0.1.1.tgz"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.2",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "ajv": "8.20.0",
    "esbuild": "^0.25.12",
    "json-schema-to-typescript": "16.0.0",
    "sharp": "0.35.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0",
    "@tinihi-labs/artifact-paths": "file:.artifacts/tinihi-labs-artifact-paths-1.0.0-m1.0.tgz"
  }
