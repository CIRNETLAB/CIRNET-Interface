  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vue-tsc --noEmit -p tsconfig.tests.json && node scripts/test.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e": "node scripts/e2e.mjs test",
    "test:e2e:install": "node scripts/e2e.mjs install chromium",
    "export:oscilloscope": "node scripts/export-oscilloscope.mjs",
    "export:generator": "node scripts/export-function-generator.mjs",
    "preview": "vite preview --host 0.0.0.0",
